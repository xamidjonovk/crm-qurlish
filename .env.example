DATABASE_URL=postgresql+psycopg://crm_owner:SET_LOCAL_PASSWORD@127.0.0.1:5432/crm_course_v3
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_CHARACTERS

# Docker Compose: use a strong URL-safe password (letters, digits, - and _).
POSTGRES_DB=crm_course_v3
POSTGRES_USER=crm_owner
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_URL_SAFE_PASSWORD
API_PORT=8001

# Production server: set CORS_ORIGINS=[] until HTTPS frontend is configured.
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
ENVIRONMENT=development
